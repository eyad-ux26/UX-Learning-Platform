{
  "name": "ux-learning-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "preview": "node scripts/build-preview.mjs",
    "tokens": "npm run build -w @uxgate/tokens",
    "dev": "npm run dev -w @uxgate/web",
    "build": "npm run build -w @uxgate/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed:content": "node supabase/scripts/seed-content.mjs",
    "seed:sql": "node supabase/scripts/seed-content.mjs --sql"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0"
  }
}

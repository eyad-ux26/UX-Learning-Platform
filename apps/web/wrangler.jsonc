// Cloudflare Workers config for UXGate.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uxgate-web",
  "main": "cf-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "uxgate-web" }],
  // Run server code near Supabase in Frankfurt instead of near each visitor.
  "placement": { "region": "aws:eu-central-1" },
  // Daily job at 02:00 UTC (05:00 Cairo) calls /api/cron/daily; the 15-minute one calls /api/cron/reminders (slice 4).
  "triggers": { "crons": ["0 2 * * *", "*/15 * * * *"] },
  // Non-secret settings. NEXT_PUBLIC_* values must also be present at build time (Workers Builds variables).
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET) are set with `wrangler secret put`, never here.
  "vars": { "UG_HTTPS": "1" },
  "observability": { "enabled": true }
}

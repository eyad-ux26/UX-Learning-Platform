// Cloudflare Workers config for UXGate.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uxgate-web",
  "main": "cf-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // /c/* (lesson files) goes to the Worker first, which answers 404: only the server reads them, through ASSETS.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": ["/c/*"] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "uxgate-web" }],
  // Run server code near Supabase in Frankfurt instead of near each visitor.
  "placement": { "region": "aws:eu-central-1" },
  // Daily jobs at 02:00 UTC (05:00 Cairo) call /api/cron/daily and /api/cron/billing (slice 5); the 15-minute one calls
  // /api/cron/reminders (slice 4).
  "triggers": { "crons": ["0 2 * * *", "*/15 * * * *"] },
  // Non-secret settings. NEXT_PUBLIC_* values must also be present at build time (Workers Builds variables).
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET, the Paymob and Paddle keys, BILLING_TOKEN_KEY, RESEND_API_KEY)
  // are set with `wrangler secret put`, never here. The full list is in docs/billing-keys.md.
  // BILLING_MOCK is NOT set here: these vars reach production too. Preview versions get it from the non-production
  // branch deploy command (`npx wrangler versions upload --var BILLING_MOCK:1`, see docs/deploy-cloudflare.md), and
  // the code still refuses test payments on uxgate.org and the production workers.dev host.
  // UG_COMING_SOON=1: the public sees only the Coming Soon page; admins use the whole tool (docs/coming-soon.md).
  // Set it to "0" in a pull request on launch day.
  "vars": { "UG_HTTPS": "1", "UG_COMING_SOON": "1", "SITE_URL": "https://uxgate.org" },
  "observability": { "enabled": true }
}

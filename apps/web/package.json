{
  "name": "@uxgate/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-content.mjs && next dev",
    "assets": "node scripts/build-assets.mjs",
    "admin:assets": "node scripts/build-admin-assets.mjs",
    "build": "node scripts/copy-content.mjs && next build",
    "check:static": "node scripts/check-static.mjs",
    "admin:sql": "node --experimental-strip-types --no-warnings scripts/admin-sql.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/lint-logical.mjs && npm run format:check",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,mts}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.15",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.2"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@uxgate/content": "*",
    "@uxgate/player": "*",
    "@uxgate/tokens": "^0.1.0",
    "hls.js": "^1.6.15",
    "next": "^15.5.28",
    "next-intl": "4.4.0",
    "pdf-lib": "^1.17.1",
    "postal-mime": "2.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  }
}

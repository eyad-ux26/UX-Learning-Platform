  {
   "start": 242.02,
   "end": 247.46,
   "text": "وحنا بنتحرق بقوات مش لازم نكون مركزين مع الحاجة اللحنا بنستخدمها على المبايل"
  },
  {
   "start": 247.46,
   "end": 251.42,
   "text": "وده يفرق معنا جدا طبعا نحن نتكلم في الباترنز ويفرق معنا فكرة لسيشنز"
  },
  {
   "start": 251.42,
   "end": 255.62,
   "text": "لنسيشنز بكون أسخير على المبايل ودي نقطة كم فيها شيء من التفصيل في كورس المبايل"
  },
  {
   "start": 255.62,
   "end": 260.02,
   "text": "يوز الإكسبينينس مهمة جدا نتشوفها وبالتالي أكيد الباترنز على ديوايز بشكل ده"
  },
  {
   "start": 260.02,
   "end": 263.22,
   "text": "هتكون مختلفة شوية عن الباترنز لما نتكلم على التابلت مثلا"
  },
  {
   "start": 263.22,
   "end": 269.22,
   "text": "اللي هيكون ميديم سايزس كرينز وهيكون برضه هو تش بيزد انتر اكشن بما بدعم معا بيكون عن طريق التتش"
  },
  {
   "start": 269.22,
   "end": 273.22,
   "text": "أو ممكن نستخدم فيه الألم فممكن نبدأ زود بعض الباترنز التانية"
  },
  {
   "start": 273.22,
   "end": 277.22,
   "text": "المش عارفة استخدامها في المبايل لكنها ممكن تكون موجودة في التابلت وهاكذا"
  },
  {
   "start": 277.22,
   "end": 283.22,
   "text": "ممكن برضه التابلت أو ادفتي ربا بأمراكز فيه أكثر شوية مرة باستخدمه عن المبايل لأنه مش هيستخدمه وانا بدحرق كتير"
  },
  {
   "start": 284.22,
   "end": 289.22,
   "text": "وانا باستخدمه وانا أسيابته وانا بدحرق فممكن يكون فيه شيء من التركيز أبطا بالسشن بتاعه بقاطول شوية"
  },
  {
   "start": 289.22,
   "end": 292.22,
   "text": "ده برضه هيختلف عن اللي وانا باستخدم الديسكتوب"
  },
  {
   "start": 292.22,
   "end": 298.22,
   "text": "الديسكتوب بلرجة كرين طبعا وبا انترقاكت معا عن طريق الكيبورد ولماوس وهاكذا مش عن طريق التتش"
  },
  {
   "start": 298.22,
   "end": 304.22,
   "text": "فبرضه ده شيء هيختلف وهي ملتاسكينج امبايل منتو دي نقطة مهمة جدا جدا تفري معا كتير في الباترنز"
  },
  {
   "start": 304.22,
   "end": 311.22,
   "text": "فاكرة انانا الديسكتوب عندي ملتاسكينج إمبايل منتو ان اقدر عمل أكتر من تسك في نفس الوقت وقدر الركص فاكتر من حاجة في نفس الوقت"
  },
  {
   "start": 311.22,
   "end": 318.22,
   "text": "وقدر لكون عندي كومپوننز كتير في الاسكينج في نفس الوقت ومش هقوم بتشتد أول لانا أنا أصلا احد مركز مش وديوا بتحررق بي وهكذا"
  },
  {
   "start": 318.22,
   "end": 326.22,
   "text": "أنا اعاد في سشن طويلة شوية بعمل مهمة طويلة شوية وانا ليش مشكلة عمل أكتر من تسك في نفس الوقت وإذا ممكن يكون مريه بالنسبال ويكون افشنط أكتر"
  },
  {
   "start": 326.22,
   "end": 333.22,
   "text": "فدخل لي الباتنة استختلف طبعاً كجائل لائز بين الديسكتب وبين المبايل أو التابلت"
  },
  {
   "start": 333.22,
   "end": 344.22,
   "text": "برضو من الديبائسة زي اللي بقيت موجودة ومتشرة مؤخراً وبتزيد هي الورابلز أو الحاجات اللي بتتلبز زي الاسمارتواجز زي الاسمارتجلاسز أو اي حاجة عماتاً اي ديبائس ممكن البيس هو يكون بتحرق بي وهكذا"
  },
  {
   "start": 344.22,
   "end": 352.22,
   "text": "وده اكيد ليه كاراكترستيكس مختلفة زي اللي هو الاسمارتواجز بتاعته صغيرة جداً بتاعته الاسمارتواجز او حتى الاسمارتجلاسز وهكذا"
  },
  {
   "start": 352.22,
   "end": 358.22,
   "text": "وإنبوت ميثوتز اللي بتكون برضو قليلة ممكن اعمل إنبوت بالصوت أو بالتاتش سريعاً وهكذا"
  },
  {
   "start": 358.22,
   "end": 363.22,
   "text": "وبكون الانتراكشنز معه سريعاً جداً وبالتالي اكيد هكون ليها باتنز مختلفة وليها قايد لائز تانية مختلفة"
  },
  {
   "start": 363.22,
   "end": 369.22,
   "text": "خلونا برضو ناخد مثال واضح على تأسير تغيير الديبائس طيب وصايز على الديزاين باتنز المستقدمة وعلى ديزاين"
  },
  {
   "start": 369.22,
   "end": 375.22,
   "text": "مثال نوشن اللي قدمنا هنضحز على الشمال الدسكتوب على اليمين نوشن على المغايل"
  },
  {
   "start": 375.22,
   "end": 380.22,
   "text": "هنضحز في فرق بير في الباتنز على سبيل المثال دوس التاسكس والبورد"
  },
  {
   "start": 380.22,
   "end": 383.22,
   "text": "هندي بيوز مختلفة بضر تحرق بينها وبين بعض في الدسكتوب"
  },
  {
   "start": 383.22,
   "end": 386.22,
   "text": "عن طريق ان هي تابس بس بروح للتاب التانية وهكذا"
  },
  {
   "start": 386.22,
   "end": 391.22,
   "text": "في المغايل مش عملنا هتابس وبدأ افتح مينيو او دروب داون ابدأ اخطار منها"
  },
  {
   "start": 391.22,
   "end": 394.22,
   "text": "الفيو اللي انا عايز اكون شايفو دلوقتي"
  },
  {
   "start": 394.22,
   "end": 397.22,
   "text": "طبعا عشان هندي صايز اقل مش قادر عمل هتابس فبلجة ان نعمل همينيو"
  },
  {
   "start": 397.22,
   "end": 399.22,
   "text": "وده ممكن يكون اختير افضل"
  },
  {
   "start": 399.22,
   "end": 402.22,
   "text": "برضو النوجيشن على الشمال في الدسكتوب"
  },
  {
   "start": 402.22,
   "end": 405.22,
   "text": "هيكون عندي نوجيشن ظاهر في نفس الوقت بقدر نوجيات بين حاجات مختلفة"
  },
  {
   "start": 405.22,
   "end": 408.22,
   "text": "على اليمين في المغايل ما عنديش المساح هننا نعمل كده"
  },
  {
   "start": 408.22,
   "end": 412.22,
   "text": "ممكن ابدأ اضيف بوتوم نوجيشن بار باترن تاني مختلف تماما"
  },
  {
   "start": 412.22,
   "end": 416.22,
   "text": "لتطلق نوجيشن تاني مختلفة حط في اربع دستانيشن بس"
  },
  {
   "start": 416.22,
   "end": 419.22,
   "text": "بدل كل اللي كانو ظهرين عندي في الدسكتوب"
  },
  {
   "start": 419.22,
   "end": 422.22,
   "text": "فبدأ اتغير الباترن اصلا لان اغيارت السايز بتاع الاسكرين"
  },
  {
   "start": 422.22,
   "end": 424.22,
   "text": "برضو بعض الاكشنز اللي ممكن تكون موجودة عن تل جدول زي"
  },
  {
   "start": 424.22,
   "end": 426.22,
   "text": "الصورت زي الفلتر وهاكذا"
  },
  {
   "start": 426.22,
   "end": 429.22,
   "text": "مفيش مساحة ان اكون احطوطهم على المغايل فبدأ احطوهم في مينيو"
  },
  {
   "start": 429.22,
   "end": 431.22,
   "text": "فبدأ اتغير كتير في الكمپوننس اللي موجودة"
  },
  {
   "start": 431.22,
   "end": 435.22,
   "text": "بدأ اتغير في الاشنز اللي نوجيشن أو الاشنز اللي اللي يمكن لقدها امكانهم منين"
  },
  {
   "start": 435.22,
   "end": 439.22,
   "text": "أو الباترن اللي ياخد من اللي الاشنز دي افهم بضبط أو شكله ايه"
  },
  {
   "start": 439.22,
   "end": 441.22,
   "text": "ونان على اللي في الدسكتوب سايز انتاي"
  },
  {
   "start": 441.22,
   "end": 444.22,
   "text": "برضو من الحاجات المؤسسة رجدا على الباترنز اللي انا هستخدم"
  },
  {
   "start": 444.22,
   "end": 447.22,
   "text": "اصلا انه نوع من انواع الباترنز هي نوع البزنس نفسه"
  },
  {
   "start": 447.22,
   "end": 451.22,
   "text": "فكلت البيتو بي او البيتو سي اللي بتعود على بزنس تو بزنس تو"
  },
  {
   "start": 451.22,
   "end": 455.22,
   "text": "او بزنس تو كونسيومر هتفرق معه جدا فانهي نوع من الباترنز انه هستخدمه"
  },
  {
   "start": 455.22,
   "end": 459.22,
   "text": "لان كل طيب فيهم اللي حاجات هتكون في الحسبان غير الطيب التاني"
  },
  {
   "start": 459.22,
   "end": 462.22,
   "text": "فكلت البيتو بي او البزنس تو بزنس هو ايه برودكت"
  },
  {
   "start": 462.22,
   "end": 465.22,
   "text": "او ايه انترأكشن بشكل عام بين بزنس و بزنس تاني"
  },
  {
   "start": 465.22,
   "end": 467.22,
   "text": "على سبيل المثال اتغير اللي بيبيع قملة"
  },
  {
   "start": 467.22,
   "end": 469.22,
   "text": "والتغير اللي بيبيع تجزئة"
  },
  {
   "start": 469.22,
   "end": 471.22,
   "text": "بينهم تعمل لكن مفيش ولاحد دي فيهم مستهلك"
  },
  {
   "start": 471.22,
   "end": 473.22,
   "text": "اتغير دا بيبيع للتغير دا"
  },
  {
   "start": 474.22,
   "end": 483.22,
   "text": "والتغير اللي بيبيع التقزئ او اللي بيبديع Understand"
  },
  {
   "start": 490.22,
   "end": 492.22,
   "text": "خدمة اللي لان ب稍 advanced"
  },
  {
   "start": 492.22,
   "end": 495.22,
   "text": "12"
  },
  {
   "start": 495.22,
   "end": 496.22,
   "text": "Erde"
  },
  {
   "start": 496.22,
   "end": 498.22,
   "text": "على سبيل المثال tomorrow"
  },
  {
   "start": 498.22,
   "end": 499.22,
   "text": "..."
  },
  {
   "start": 499.22,
   "end": 502.22,
   "text": "يستخدموا بمطا epsilon"
  },
  {
   "start": 502.22,
   "end": 504.62,
   "text": "يمكن أن يكون بتعمل معه النوعين من البزنس في نفس الوقت"
  },
  {
   "start": 504.62,
   "end": 507.46,
   "text": "يكون عندي منتج B2C بزنس تو كونسيومر"
  },
  {
   "start": 507.46,
   "end": 510.54,
   "text": "المستخدمين بيستخدموا عشان يطلبوا من المطعم نفسه"
  },
  {
   "start": 510.54,
   "end": 513.86,
   "text": "وهيكون عندي ممكن منتج تاني بتعمل بي مع المطاع من نفسه"
  },
  {
   "start": 513.86,
   "end": 515.66,
   "text": "مع شان يبدأ يجلهم عليه الأردرز"
  },
  {
   "start": 515.66,
   "end": 517.86,
   "text": "اللي حالة قبل الاكلكيشن بتاعة او البرودر"
  },
  {
   "start": 517.86,
   "end": 519.26,
   "text": "بتاعة انا اش قصيرا"
  },
  {
   "start": 519.26,
   "end": 521.54,
   "text": "ويبدأوا من عليهم يحطوا الواجبات الموجودة"
  },
  {
   "start": 521.54,
   "end": 523.74,
   "text": "أو الامش موجودة ووقت التوصيل وهاكذا"
  },
  {
   "start": 523.82,
   "end": 525.78,
   "text": "فما يكون عندهم منتج مختلفة عن المنتج"
  },
  {
   "start": 525.78,
   "end": 528.06,
   "text": "اللي موجودة عن المستخدمين المستهلكين"
  },
  {
   "start": 528.06,
   "end": 530.22,
   "text": "فأنا في الحالة دي عندي النوعين من المنتجات"
  },
  {
   "start": 530.22,
   "end": 532.66,
   "text": "وانا نفس الشركة عندي B2C وعندي B2B"
  },
  {
   "start": 532.66,
   "end": 535.1,
   "text": "طبعا كل نوع من النوعين هي يكون في حاجات تخدها"
  },
  {
   "start": 535.1,
   "end": 537.26,
   "text": "في عين الاعتبار مختلفة عن النوع التاني"
  },
  {
   "start": 537.26,
   "end": 539.98,
   "text": "على سبيل المساعد في البتو بي أو البزنس تو بزنس"
  },
  {
   "start": 539.98,
   "end": 541.94,
   "text": "بروتكس هبدأ أركز على الايفشنسي"
  },
  {
   "start": 541.94,
   "end": 543.94,
   "text": "ان التسكات اللي يوزر بعمله اللي بيستخدم"
  },
  {
   "start": 543.94,
   "end": 546.18,
   "text": "البروتكت البتو بي ده تكون سريعة"
  },
  {
   "start": 546.18,
   "end": 548.5,
   "text": "لان التسكات دي عادة بي تكون حاجة متكبرة"
  },
  {
   "start": 548.5,
   "end": 551.98,
   "text": "فهبدأ أشوف إيه الشرطكاتس اللي يمكن تسهل عليه التسكس المتكبرة دي"
  },
  {
   "start": 551.98,
   "end": 554.02,
   "text": "هبدأ أشوف لو فيه حاجة ممكن تكون"
  },
  {
   "start": 554.02,
   "end": 557.42,
   "text": "قطميتد بشكل ما عشان تسهل عليه برضو التسكات المتكبرة دي"
  },
  {
   "start": 557.42,
   "end": 560.02,
   "text": "هفكر إيه زي ممكن الديل وانفرميشن قدر المستطاع"
  },
  {
   "start": 560.02,
   "end": 562.78,
   "text": "زي داشبورس اللي بتبدأ تارض للبزنس"
  },
  {
   "start": 562.78,
   "end": 564.34,
   "text": "وبعب قد ايه عنده حاجات"
  },
  {
   "start": 564.34,
   "end": 565.66,
   "text": "قد ايه منتجات في الستوب"
  },
  {
   "start": 565.66,
   "end": 567.74,
   "text": "وهكذا بتبدأ تديل وانفرميشن عام معن"
  },
  {
   "start": 568.38,
   "end": 569.78,
   "text": "وحالة البزنس حالياً"
  },
  {
   "start": 569.78,
   "end": 571.58,
   "text": "والتعملات اللي بتحصل وهكذا"
  },
  {
   "start": 571.58,
   "end": 572.9,
   "text": "هبدأ أركز جدنا برضو على"
  },
  {
   "start": 572.9,
   "end": 575.3,
   "text": "الفونكشناليتي أكثر مهركز على بساطة الديزاين"
  },
  {
   "start": 575.3,
   "end": 578.14,
   "text": "مثلا هبدأ أركز المهم الفونكشناليتي تكون سليمة"
  },
  {
   "start": 578.14,
   "end": 580.66,
   "text": "حتى لو عمل قدوة الممكن يكون كبير شوية"
  },
  {
   "start": 580.66,
   "end": 582.78,
   "text": "لكن مهمة جداً هولكم بقدر الفونكشناليتي"
  },
  {
   "start": 582.78,
   "end": 586.18,
   "text": "بشكل سليم والفونكشناليتي فعلا اللي البزنس عايزها"
  },
  {
   "start": 586.18,
   "end": 589.22,
   "text": "لكن في حالة B2C مثلا أو البزنس توكن سيومر"
  },
  {
   "start": 589.22,
   "end": 590.74,
   "text": "هبدأ أركز أكثر في الانجاج منتج"
  },
  {
   "start": 591.74,
   "end": 594.74,
   "text": "ينجج ممكن أعمل حاجة يكون فيها نوع من"
  },
  {
   "start": 594.74,
   "end": 597.74,
   "text": "الجميفيكيشن يخلي فيه شوية جميفيكيشن في الديزاين"
  },
  {
   "start": 597.74,
   "end": 599.74,
   "text": "البساطة برضو فيه الديزاين عشان ديوزر"
  },
  {
   "start": 599.74,
   "end": 601.74,
   "text": "يستخدم يخلص التسكس بسهولة"
  },
  {
   "start": 601.74,
   "end": 604.74,
   "text": "ما يحتاجشن هو يعمل خطوات كتير في التسكس"
  },
  {
   "start": 604.74,
   "end": 606.74,
   "text": "على عكس البتوبي اللي ممكن يكون"
  },
  {
   "start": 606.74,
   "end": 608.74,
   "text": "أعد أصلاً بركز عشان يعمل تسك"
  },
  {
   "start": 608.74,
   "end": 610.74,
   "text": "طويلة شوية تسك مع مقدة شوية"
  },
  {
   "start": 610.74,
   "end": 612.74,
   "text": "فممكن يكون الموضوع في بعض التعقدات"
  },
  {
   "start": 612.74,
   "end": 614.74,
   "text": "لأنه هيعمل حاجات كتيرة"
  },
  {
   "start": 615.74,
   "end": 618.74,
   "text": "لأنه يحتاج يعمل تسك عاداتاً بيكون أبسط بكتير"
  },
  {
   "start": 618.74,
   "end": 620.74,
   "text": "فما حاجة حول نخلل الموضوع"
  },
  {
   "start": 620.74,
   "end": 622.74,
   "text": "يكون بسيط قدر المستطاع"
  },
  {
   "start": 622.74,
   "end": 625.74,
   "text": "وطبعاً أن الديزاين يكون جميل وشكله جزاب وهكذا"
  },
  {
   "start": 625.74,
   "end": 627.74,
   "text": "وكدحنا فهمنا أن تغيير البلادفورم"
  },
  {
   "start": 627.74,
   "end": 629.74,
   "text": "أو تغيير الديويس تايب انسايز"
  },
  {
   "start": 629.74,
   "end": 630.74,
   "text": "أو تغيير نوع البزنس"
  },
  {
   "start": 630.74,
   "end": 632.74,
   "text": "ممكن يأسر على الديزاين باتنز"
  },
  {
   "start": 632.74,
   "end": 633.74,
   "text": "سواء انك جايل دلائنز"
  },
  {
   "start": 633.74,
   "end": 634.74,
   "text": "أو كموسمات"
  },
  {
   "start": 634.74,
   "end": 636.74,
   "text": "أو كباتنز أصلاً أنا باستخدم"
  }
 ]
}
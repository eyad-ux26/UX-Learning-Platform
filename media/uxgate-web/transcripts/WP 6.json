   "text": "برضو او بنتزاين تكست فيلز مش افضل حاجة دايمان نحن سبت المارجنز اللي من بره ونسيب التكست فيل ده يكبر كل ما سياشة تكبر لان ممكن يوصل في احد الحالات ان يكون عريد جدا واخد عبد الشاشة كلها"
  },
  {
   "start": 272.18,
   "end": 275.94,
   "text": "اللي نحن سبتين بس المارجنز من اليمين والشمال وكده هو بتحرك مع الشاشة"
  },
  {
   "start": 276.02,
   "end": 284.5,
   "text": "فالافضل دايمان احنا نديله مكس ما موتث لما يوصل عنده وخلاصه يوقف مش هيتوه اكثر من كده ان تكست فيل ده طويل طبعا مش افضل حاجة زي حتى الاراية لما كن نتكلم عن التكست"
  },
  {
   "start": 284.5,
   "end": 290.74,
   "text": "لما كن نتكلم عن البرغرف ان مش افضل حاجة نحن نخليه وصلوا ويتاخر الصفحة يكون تكست طويل جدا واخد عرض الشاشة كلها"
  },
  {
   "start": 290.74,
   "end": 294.26,
   "text": "وبيوصله ويرجع تاني من اول الشاشة عشان يقرأ السطر اللي بعد وهاكذا"
  },
  {
   "start": 294.26,
   "end": 298.5,
   "text": "احتاج وصل عنده حتى يكون دايمان مكس ما موتث اللي هو يوصله ويبدأ انزل للصطر اللي تحدث"
  },
  {
   "start": 298.5,
   "end": 304.46,
   "text": "وبما اننا نتكلم عن التكست فيلز فهي مهم جدا نتكلم عن الفورمز وهي اكتر حاجة بيستخدم فيها التكست فيلز"
  },
  {
   "start": 304.46,
   "end": 309.66,
   "text": "ونستخدمها بحالات كتيرة جدا في برودرس متنووعة وحنا بنشتري وحنا بنعمل لوجن وحنا بندخل بقناتنا"
  },
  {
   "start": 309.66,
   "end": 314.26,
   "text": "وفي حالات اختلفة كتير فخلونا نشوف بعض الجايد لانزل اللي هي علاقة بالفورمز عماتا"
  },
  {
   "start": 314.58,
   "end": 316.58,
   "text": "وبالاسمس فيلز جوه االفورمز بتحديب"
  },
  {
   "start": 316.58,
   "end": 322.26,
   "text": "لو شفن اول جايد لائي معانا هنلاقي نحنا محتاجين نخلي اللي فورم دايما يكون صير قدر المستطعة"
  },
  {
   "start": 322.26,
   "end": 324.26,
   "text": "إزاي نخل اللي فورم صير على الدى من أي أخر"
  },
  {
   "start": 324.26,
   "end": 327.26,
   "text": "أول حاجة نبدأ نرجع لحاجات اللي حطنها في الفورم"
  },
  {
   "start": 327.26,
   "end": 329.26,
   "text": "لو احنا كتبنا كل اللي حاجات اللي نحججينها جمعها"
  },
  {
   "start": 329.26,
   "end": 332.26,
   "text": "كل البيانات اللي نحتاجين نخدها من الليوزر في فورم دا"
  },
  {
   "start": 332.26,
   "end": 335.26,
   "text": "نبدأ نرجع بعد كده هل في بانات نقدر نخدها بعد كده بشكل ماء"
  },
  {
   "start": 335.26,
   "end": 338.06,
   "text": "بشكل ما هل في بيانات نجد الروية أصفاً نخدها"
  },
  {
   "start": 338.06,
   "end": 341.16,
   "text": "ونبدأ نشيل البيانات دي أو الدات دي من اليوزر"
  },
  {
   "start": 341.16,
   "end": 343.56,
   "text": "عشان نخلي الفورم أصير قدر المستطاعة"
  },
  {
   "start": 343.56,
   "end": 347.16,
   "text": "تاني حاجة نحن نحاول نخلي دايما الحاجات اللي حلاقب بعض"
  },
  {
   "start": 347.16,
   "end": 351.06,
   "text": "في الفورم تكون قريبا من بعض فيجوالي أو تكون بايما بعضاً هي جروب واحد"
  },
  {
   "start": 351.06,
   "end": 353.76,
   "text": "بمعنى في المسال اللي قدما دا لو شوفنا كلمة باسورت"
  },
  {
   "start": 353.76,
   "end": 356.36,
   "text": "اللي بالبتاع باسورت اللي هو أصلا بتاع الفيلد التاني"
  },
  {
   "start": 356.56,
   "end": 360.36,
   "text": "المسافة بينه وبين الفيلد الأول وبينه بين الفيلد التاني تقريباً هي نفسها"
  },
  {
   "start": 360.36,
   "end": 363.46,
   "text": "فمجباً ان الفيلد التاني هو أقرب للتاني وهو تراع التاني"
  },
  {
   "start": 363.46,
   "end": 366.36,
   "text": "معنى هو كده كده واضح انه هو تراع الفيلد التاني"
  },
  {
   "start": 366.36,
   "end": 370.16,
   "text": "لكن لما يكون الفورم طويل هكون موضع مش أضرب حاجة كون موضوع"
  },
  {
   "start": 370.16,
   "end": 373.06,
   "text": "باين كأنه ممكن يكون سبورتين تكسل الفيلد الأول"
  },
  {
   "start": 373.06,
   "end": 377.16,
   "text": "فهيكون بيجوالي مش أفضل حاجة فدايما نحاول أقرب الليبل من الفورم نفسه"
  },
  {
   "start": 377.16,
   "end": 379.96,
   "text": "برضو في حالة نان عندي بلما داية مختلفة"
  },
  {
   "start": 380.06,
   "end": 381.36,
   "text": "ممكن أسمها سكشنس"
  },
  {
   "start": 381.36,
   "end": 383.16,
   "text": "على حسب اللي أنا بطلو بيرسنل امفرميشن"
  },
  {
   "start": 383.16,
   "end": 385.16,
   "text": "مثل اللي بعدين بطلو بايمينت امفرميشن"
  },
  {
   "start": 385.16,
   "end": 388.56,
   "text": "فبدأ أسمهم بيرسنل وبييمينت وهاكذا أسمهم للسكاشن"
  },
  {
   "start": 388.56,
   "end": 393.36,
   "text": "فشن حتى أسهل على الوزر إنه هو يفهم كل سكشن بيكلم عن اي الداتة دي بتاعت اي بالضبط"
  },
  {
   "start": 393.36,
   "end": 398.76,
   "text": "وبردو أسهل علي فكتن هو بيخلص سكشن ويتخلل السكشن اللي بعد هو هكذا ما يكونش فورم مكامل طويل"
  },
  {
   "start": 398.76,
   "end": 400.76,
   "text": "إنه ممكن يكون مزاك أحياناً"
  },
  {
   "start": 400.96,
   "end": 406.56,
   "text": "ثالث حاجة نحن دايماً نحاول نخلي الفورم تكون فيه الفيلز أو اي امبوز موجودة فيه تحت باعة أفضل"
  },
  {
   "start": 406.56,
   "end": 412.56,
   "text": "نحن نخليهم في عمودين جمب بعض لان دا بيقطع حارة النظر أو أننا بنزل بيرتكيل بخلص الحاجات تحت باعة"
  },
  {
   "start": 412.56,
   "end": 416.56,
   "text": "إلا طبعاً لو في حارة إنه فيه حاجة اللوجيك إنه يكون جمب بعض ليها اللوجيك معين"
  },
  {
   "start": 416.56,
   "end": 419.36,
   "text": "ممكن يخليني خطاها جمب بعض أو ممكن يكون دا أفضل"
  },
  {
   "start": 419.36,
   "end": 422.76,
   "text": "زي الاكسبيرشن ديت والسببية حاجات ليهم علاقة بعض في البييمينت مثل"
  },
  {
   "start": 422.76,
   "end": 429.76,
   "text": "هو أصلاً سيفيفي بيكون برض رقم صغير فممكن نحطوه مفيه عمودين جمب بعض لكن غير كده الأفضل دا ما نحن نخليهم في سانجل الكورم"
  },
  {
   "start": 429.76,
   "end": 433.76,
   "text": "لو شفت برضو الحاجة اللي معينة بعد كده فاكرة إنه استخدم اللوجيك للسيكوانس"
  },
  {
   "start": 433.76,
   "end": 438.76,
   "text": "إزاي فكر إنه أنا بلقادي باستخدم اللوجيك للسيكوانس أو ها استخدم اللوجيك للسيكوانس"
  },
  {
   "start": 438.76,
   "end": 442.76,
   "text": "وولا لقاة ممكن أفكر هل اليوزر بوقت ما هو جملة الداتة دي"
  },
  {
   "start": 442.76,
   "end": 445.92,
   "text": "فهو يعمل حاجة معينا و يأخب منها الداتة لمعنى زي مثل المسال اللي قدامنا"
  },
  {
   "start": 445.92,
   "end": 449.9,
   "text": "لو هو بياخد داتة من الكريدت كارد فهو دي لقيت بيبص في الكريدت كارد من قدام"
  },
  {
   "start": 449.9,
   "end": 452.84,
   "text": "بيقرأ أول حاجة رقم الكريدت كارد بعدين بيقرأ الإكسبيريشن ديت"
  },
  {
   "start": 452.84,
   "end": 455.52,
   "text": "بعدين بيلف الكريدت كارد دي قرأت cv من وراء"
  },
  {
   "start": 455.52,
   "end": 457.6,
   "text": "فهو ده الترتيب اللي هو بيمشي بي"
  },
  {
   "start": 457.6,
   "end": 460.16,
   "text": "فهو ده اللوجيك اللي أنا استخدامه عشان حطلوا الفيلد"
  },
  {
   "start": 460.16,
   "end": 464.04,
   "text": "سابقى أطلو الرقم بديها الكريدت كارد في الأول بعدين الإكسبيريشن ديت"
  },
  {
   "start": 464.04,
   "end": 466.16,
   "text": "بعدين cv عشان يقلبوا يشوف من وراء"
  },
  {
   "start": 466.16,
   "end": 469.16,
   "text": "برضو لو في حاجات اللي علاقة اللوجيك و قضحة جداً"
  },
  {
   "start": 469.16,
   "end": 471.16,
   "text": "وبدي هي مع بعض زي الفرس نيم واللسط نيم"
  },
  {
   "start": 471.16,
   "end": 474.16,
   "text": "أكيد الفرس نيم هي كده الأول بعدين اللسط نيم وهكذا"
  },
  {
   "start": 474.16,
   "end": 479.16,
   "text": "فبدأ فكر في الحاجات دي هل في حاجة تخلييني أحب اللوجيك معين أو ترتيب معين في الفيلد"
  },
  {
   "start": 479.16,
   "end": 481.16,
   "text": "ولا مش هكون فارق الترتيب أول"
  },
  {
   "start": 481.16,
   "end": 485.16,
   "text": "النقطة الخاص اللي معانا فيها هي البلسلودر و دي من نقطة المتكررة"
  },
  {
   "start": 485.16,
   "end": 489.16,
   "text": "فكرة البلسلودر أو مسما البلسلودر دايما هو الحاجة اللي واخدها مكان"
  },
  {
   "start": 489.16,
   "end": 492.16,
   "text": "لغاية ما هكون حاجة تانية هي الأساسية لحتي قتل تأخذ المكان ده"
  },
  {
   "start": 492.16,
   "end": 494.16,
   "text": "بمعنى لمن أقول بلسلودر في التكسط فيلد"
  },
  {
   "start": 494.16,
   "end": 499.16,
   "text": "فهو التكسط المكتوب جوى التكسط فيلد اللي بيفهمني بس أنا ممكن أكتب هناء"
  },
  {
   "start": 499.16,
   "end": 502.16,
   "text": "لغاية ماكتب التكسط الرئيسي اللي هكون مكتب جوى اسطة فيلد"
  },
  {
   "start": 502.16,
   "end": 504.16,
   "text": "الانبود الان هتخليوك يوزر"
  },
  {
   "start": 511.16,
   "end": 513.16,
   "text": "يجب أن نستخدم البلايس وولدرس"
  },
  {
   "start": 513.16,
   "end": 515.16,
   "text": "لأننا ببساطة أول من نبدأ أن نكتب هذا الخطفي"
  },
  {
   "start": 515.16,
   "end": 517.16,
   "text": "ويمكن البلايس وولدرس دي أنا بعايز أراهة تاني"
  },
  {
   "start": 517.16,
   "end": 519.16,
   "text": "عشان أفتكر اللي قايد لائنة"
  },
  {
   "start": 519.16,
   "end": 521.16,
   "text": "اللي كان مكتوب أو اللي كان مكتوب"
  },
  {
   "start": 521.16,
   "end": 523.16,
   "text": "في شكل بلايس وولدر"
  },
  {
   "start": 523.16,
   "end": 525.16,
   "text": "وهو اختفى دلوقتي"
  },
  {
   "start": 525.16,
   "end": 527.16,
   "text": "فعشان أصله ممكن أن أحتاج إن أنا أمسح"
  },
  {
   "start": 527.16,
   "end": 529.16,
   "text": "التكسط اللي أنا كتبته كله"
  },
  {
   "start": 529.16,
   "end": 531.16,
   "text": "عشان أراهة تاني بزاة إذا كان فيه معلومة مهمة"
  },
  {
   "start": 531.16,
   "end": 533.16,
   "text": "فأضل حاجة دايما نخلي"
  },
  {
   "start": 533.16,
   "end": 535.16,
   "text": "يجب أن نكتبه كبلايس وولدرس"
  },
  {
   "start": 535.16,
   "end": 537.16,
   "text": "يأم يكون فوق الفورم أو تحت فوق التكسط فيلد"
  },
  {
   "start": 537.16,
   "end": 539.16,
   "text": "أو تحت التكسط فيلد بالشكل ده"
  },
  {
   "start": 539.16,
   "end": 541.16,
   "text": "عشان يكون معضح لي"
  },
  {
   "start": 541.16,
   "end": 543.16,
   "text": "الحاجة اللي أنا كتبه وما يختفيش وانا بكتب"
  },
  {
   "start": 543.16,
   "end": 545.16,
   "text": "وبرضه في بعض الحالات بيكون في فكرة"
  },
  {
   "start": 545.16,
   "end": 547.16,
   "text": "الفلوط إنجليب لذي تكلمنا عنه"
  },
  {
   "start": 547.16,
   "end": 549.16,
   "text": "وليس بيكون بلايس وولدرس"
  },
  {
   "start": 549.16,
   "end": 551.16,
   "text": "هو بيكون قوة التكسط فيلد"
  },
  {
   "start": 551.16,
   "end": 553.16,
   "text": "ولم أبدأ أكتب بيطلع فوق"
  },
  {
   "start": 553.16,
   "end": 555.16,
   "text": "بيفلوط بيتحرك إنه يكون فوق التكسط فيلد"
  },
  {
   "start": 555.16,
   "end": 557.16,
   "text": "وبيكون شايف وبرضه وانا بكتب"
  },
  {
   "start": 557.16,
   "end": 559.16,
   "text": "اللي قوة التكسط فيلد"
  },
  {
   "start": 559.16,
   "end": 561.16,
   "text": "فدايما نخلينا نحاول نتجنب الفلوط"
  },
  {
   "start": 561.16,
   "end": 563.16,
   "text": "وبرضه في حالات اللي ممكن تكون بطلخل بعض الناس"
  },
  {
   "start": 563.16,
   "end": 565.16,
   "text": "في نقطة الفلوط"
  },
  {
   "start": 565.16,
   "end": 567.16,
   "text": "هي الساش"
  },
  {
   "start": 567.16,
   "end": 569.16,
   "text": "الساش عدتا بيكون مكتب قوة"
  },
  {
   "start": 569.16,
   "end": 571.16,
   "text": "نحنا نعمل ساش"
  },
  {
   "start": 571.16,
   "end": 573.16,
   "text": "ده مش تكسط فيلد"
  },
  {
   "start": 573.16,
   "end": 575.16,
   "text": "الساش مش بيتعمل كتكسط فيلد"
  },
  {
   "start": 575.16,
   "end": 577.16,
   "text": "ومن أفضل حان إنه يكتب قوة ساش"
  },
  {
   "start": 577.16,
   "end": 579.16,
   "text": "وهو بيكون مفهوم إنه هو ساش"
  },
  {
   "start": 579.16,
   "end": 581.16,
   "text": "في أغلب الأوقات وهو وفوق في الوبسايدs"
  },
  {
   "start": 581.16,
   "end": 583.16,
   "text": "ما بيطبقش عن نفس"
  },
  {
   "start": 583.16,
   "end": 585.16,
   "text": "دايدلين اللي بيطبق على التكسط فيه"
  },
  {
   "start": 585.16,
   "end": 587.16,
   "text": "دايدلين اللي معنا بعد كده شوفناها قبل كده"
  },
  {
   "start": 587.16,
   "end": 589.16,
   "text": "لما كنو من نتكلم عن رادي بوتنس"
  },
  {
   "start": 589.16,
   "end": 591.16,
   "text": "وهي فكرة إن أنا أخطار الفيلد المناسب"
  },
  {
   "start": 591.16,
   "end": 593.16,
   "text": "أو تايب المناسب"
  },
  {
   "start": 593.16,
   "end": 595.16,
   "text": "لكل إمبوط أنا بطلوه من اليوزر"
  },
  {
   "start": 595.16,
   "end": 597.16,
   "text": "زي الحلل قدامنا اللي كلمنا عنها وبرضه قبل كده"
  },
  {
   "start": 597.16,
   "end": 599.16,
   "text": "لو أنا عندي ثلاث اختيارات"
  },
  {
   "start": 599.16,
   "end": 601.16,
   "text": "فهل الأفضل أنا نخطار رادي بوتنس"
  },
  {
   "start": 601.16,
   "end": 603.16,
   "text": "ولا روب داون"
  },
  {
   "start": 603.16,
   "end": 605.16,
   "text": "فالأفضل داون أنا نخطار رادي بوتنس"
  },
  {
   "start": 606.16,
   "end": 608.16,
   "text": "لاني هبقى شايف اختيارات كلها على قول"
  },
  {
   "start": 608.16,
   "end": 610.16,
   "text": "لو اختيارات كتيرة"
  },
  {
   "start": 610.16,
   "end": 611.16,
   "text": "أو أنا ما عنديش مساحة كفاية"
  },
  {
   "start": 611.16,
   "end": 613.16,
   "text": "فهي هستخدم الدروب داون"
  },
  {
   "start": 613.16,
   "end": 614.16,
   "text": "هبدأ فكر إيه"
  },
  {
   "start": 614.16,
   "end": 615.16,
   "text": "التايب المناسب من"
  },
  {
   "start": 615.16,
   "end": 617.16,
   "text": "الباترنز اللي هستخدمه"
  },
  {
   "start": 617.16,
   "end": 619.16,
   "text": "ونان على الإمبوط اللي نعايزه من اليوزر"
  },
  {
   "start": 619.16,
   "end": 621.16,
   "text": "ورده السايز أكيد هعم حساب"
  },
  {
   "start": 621.16,
   "end": 622.16,
   "text": "السايز لو نطالب من اليوزر"
  },
  {
   "start": 622.16,
   "end": 623.16,
   "text": "إميل أدرس"
  },
  {
   "start": 623.16,
   "end": 624.16,
   "text": "مش هديه لو تكسط فيلد صغير"
  },
  {
   "start": 624.16,
   "end": 625.16,
   "text": "محتاج دين تكسط فيلد"
  },
  {
   "start": 625.16,
   "end": 627.16,
   "text": "كيف إن هو يكتب في الإميل أدرس"
  },
  {
   "start": 627.16,
   "end": 628.16,
   "text": "وهاكذا"
  },
  {
   "start": 628.16,
   "end": 629.16,
   "text": "الحاجة اللي معنا بعد كده"
  },
  {
   "start": 629.16,
   "end": 631.16,
   "text": "ودي حاجة مهمة جدا جدا"
  },
  {
   "start": 631.16,
   "end": 632.16,
   "text": "فكرت إن أنا أبيّن لليوزر"
  },
  {
   "start": 632.16,
   "end": 634.16,
   "text": "إيه هي الفيديس أو الإمبوط"
  },
  {
   "start": 634.16,
   "end": 636.16,
   "text": "المطلوب من هو يدخلها"
  },
  {
   "start": 636.16,
   "end": 637.16,
   "text": "اكبرين أو مهمة جدا لازم يدخلها"
  },
  {
   "start": 637.16,
   "end": 638.16,
   "text": "حشان يقدر يكمل"
  },
  {
   "start": 638.16,
   "end": 640.16,
   "text": "وإيه الفيديس الوبشنال"
  },
  {
   "start": 640.16,
   "end": 641.16,
   "text": "الاختيارية اللي هم"
  },
  {
   "start": 641.16,
   "end": 642.16,
   "text": "مش لازم يدخلها"
  },
  {
   "start": 642.16,
   "end": 643.16,
   "text": "وممكن يكمل عيد"
  },
  {
   "start": 643.16,
   "end": 644.16,
   "text": "في حالة دي ممكن نبيّن"
  },
  {
   "start": 644.16,
   "end": 646.16,
   "text": "الحاجات الدرورية بس"
  },
  {
   "start": 646.16,
   "end": 647.16,
   "text": "أو إيه الاجبارية بس"
  },
  {
   "start": 647.16,
   "end": 648.16,
   "text": "بإيه النجمة"
  },
  {
   "start": 648.16,
   "end": 649.16,
   "text": "أنا أبيّن لو النجمال حمره"
  },
  {
   "start": 650.16,
   "end": 651.16,
   "text": "دي حاجة لازم تدخلها"
  },
  {
   "start": 651.16,
   "end": 652.16,
   "text": "أو إن أنا أبيّن"
  },
  {
   "start": 652.16,
   "end": 653.16,
   "text": "الحاجة الوبشنال"
  },
  {
   "start": 653.16,
   "end": 654.16,
   "text": "إن أنا كتب لو بي"
  },
  {
   "start": 654.16,
   "end": 655.16,
   "text": "بسين جنب اللي بالبطاعها"
  },
  {
   "start": 655.16,
   "end": 656.16,
   "text": "نديد اوبشنال"
  },
  {
   "start": 656.16,
   "end": 657.16,
   "text": "لش لازم يكتبها"
  },
  {
   "start": 657.16,
   "end": 658.16,
   "text": "أو أعمل اللي تنين"
  },
  {
   "start": 658.16,
   "end": 659.16,
   "text": "وده ممكن يكون أفضل"
  },
  {
   "start": 659.16,
   "end": 660.16,
   "text": "إن أنا حطول نجمة"
  },
  {
   "start": 660.16,
   "end": 661.16,
   "text": "جنب الحاجات الإكبرية"
  },
  {
   "start": 661.16,
   "end": 662.16,
   "text": "ووبشنال جنب الحاجات"
  },
  {
   "start": 662.16,
   "end": 663.16,
   "text": "الإختارية"
  },
  {
   "start": 663.16,
   "end": 664.16,
   "text": "عشان يضري"
  },
  {
   "start": 664.16,
   "end": 665.16,
   "text": "ميز بين اللي تنين بسهولها"
  },
  {
   "start": 665.16,
   "end": 666.16,
   "text": "ومحتكش"
  },
  {
   "start": 666.16,
   "end": 667.16,
   "text": "يعطي فاكة كتير"
  },
  {
   "start": 667.16,
   "end": 668.16,
   "text": "أو يجرب ويظهر"
  },
  {
   "start": 668.16,
   "end": 669.16,
   "text": "وهاكذا"
  },
  {
   "start": 669.16,
   "end": 670.16,
   "text": "الجايد لائن"
  },
  {
   "start": 670.16,
   "end": 671.16,
   "text": "عن الفرمز"
  },
  {
   "start": 671.16,
   "end": 672.16,
   "text": "ومعين اللي تكست فيلز"
  },
  {
   "start": 672.16,
   "end": 673.16,
   "text": "تحديدا هي إن أنا أبيّن"
  },
  {
   "start": 673.16,
   "end": 674.16,
   "text": "لليوزر لو فيه"
  },
  {
   "start": 674.16,
   "end": 675.16,
   "text": "حاجات معيانة"
  },
  {
   "start": 675.16,
   "end": 676.16,
   "text": "كاراكترستيكس"
  },
  {
   "start": 676.16,
   "end": 677.16,
   "text": "معيانة المفروض يعملها"
  },
  {
   "start": 677.16,
   "end": 678.16,
   "text": "في التكست اللي هو بيكتبه"
  },
  {
   "start": 678.16,
   "end": 679.16,
   "text": "على سبيل المثال"
  },
  {
   "start": 679.16,
   "end": 680.16,
   "text": "لو أنا"
  },
  {
   "start": 680.16,
   "end": 681.16,
   "text": "عايز يكتب باسور"
  },
  {
   "start": 681.16,
   "end": 682.16,
   "text": "وفي إنستركشنز معيانة"
  },
  {
   "start": 682.16,
   "end": 683.16,
   "text": "لازم يلتزم بيها"
  },
  {
   "start": 683.16,
   "end": 684.16,
   "text": "في الباسور ده"
  },
  {
   "start": 684.16,
   "end": 685.16,
   "text": "زي إن يكم فيه"
  },
  {
   "start": 685.16,
   "end": 686.16,
   "text": "حرف كابتل على قل"
  },
  {
   "start": 686.16,
   "end": 687.16,
   "text": "ويكم فيه"
  },
  {
   "start": 687.16,
   "end": 688.16,
   "text": "سباشر كاراكتر"
  },
  {
   "start": 688.16,
   "end": 689.16,
   "text": "وهاكذا"
  },
  {
   "start": 689.16,
   "end": 690.16,
   "text": "فمحتك أبيّن"
  },
  {
   "start": 690.16,
   "end": 691.16,
   "text": "لو دائم"
  },
  {
   "start": 692.16,
   "end": 693.16,
   "text": "إن دائمتك المفروض"
  },
  {
   "start": 693.16,
   "end": 694.16,
   "text": "تايمة كذا"
  },
  {
   "start": 694.16,
   "end": 695.16,
   "text": "وكذا"
  },
  {
   "start": 695.16,
   "end": 696.16,
   "text": "احتاج بيانه دايما"
  },
  {
   "start": 696.16,
   "end": 697.16,
   "text": "إي ريكوالمنس"
  },
  {
   "start": 697.16,
   "end": 698.16,
   "text": "أو إي"
  },
  {
   "start": 698.16,
   "end": 699.16,
   "text": "الإنستركشنز"
  },
  {
   "start": 699.16,
   "end": 700.16,
   "text": "أو الكاراكترستيكس"
  },
  {
   "start": 700.16,
   "end": 701.16,
   "text": "المفروض يلتزم بيها"
  },
  {
   "start": 701.16,
   "end": 702.16,
   "text": "وهو يدخل"
  },
  {
   "start": 702.16,
   "end": 703.16,
   "text": "الإنبوط"
  },
  {
   "start": 703.16,
   "end": 704.16,
   "text": "اللي هو بيستخدامه"
  },
  {
   "start": 704.16,
   "end": 705.16,
   "text": "ودلوقتي"
  },
  {
   "start": 705.16,
   "end": 706.16,
   "text": "كمان فاوقات كتير"
  },
  {
   "start": 706.16,
   "end": 707.16,
   "text": "بيلايب بعض الفورمز"
  },
  {
   "start": 707.16,
   "end": 708.16,
   "text": "في زرار كلير"
  },
  {
   "start": 708.16,
   "end": 709.16,
   "text": "أو زرار ريستك"
  },
  {
   "start": 709.16,
   "end": 710.16,
   "text": "اللي بيخلي"
  },
  {
   "start": 710.16,
   "end": 711.16,
   "text": "أمسح كل الداتة"
  },
  {
   "start": 711.16,
   "end": 712.16,
   "text": "اللي أنا كنابتها"
  },
  {
   "start": 712.16,
   "end": 713.16,
   "text": "في الفورم"
  },
  {
   "start": 713.16,
   "end": 714.16,
   "text": "زور ده"
  },
  {
   "start": 714.16,
   "end": 715.16,
   "text": "نادر جدا"
  },
  {
   "start": 715.16,
   "end": 716.16,
   "text": "اللي هو كتابها كلها"
  },
  {
   "start": 716.16,
   "end": 717.16,
   "text": "بيخلي محتاج"
  },
  {
   "start": 717.16,
   "end": 718.16,
   "text": "إي تكتابة الداتة"
  },
  {
   "start": 718.16,
   "end": 719.16,
   "text": "تاني"
  },
  {
   "start": 719.16,
   "end": 720.16,
   "text": "أو أصلا بيطلع من الوبسايت"
  },
  {
   "start": 720.16,
   "end": 721.16,
   "text": "ومش بيكتب الداتة"
  },
  {
   "start": 721.16,
   "end": 722.16,
   "text": "دي تاني"
  },
  {
   "start": 722.16,
   "end": 723.16,
   "text": "فمهم إحنا"
  },
  {
   "start": 723.16,
   "end": 724.16,
   "text": "ما نستخدمش"
  },
  {
   "start": 724.16,
   "end": 725.16,
   "text": "ريست كلير"
  },
  {
   "start": 725.16,
   "end": 726.16,
   "text": "وطنز عادة"
  },
  {
   "start": 726.16,
   "end": 727.16,
   "text": "نش بيستخدمه"
  },
  {
   "start": 727.16,
   "end": 728.16,
   "text": "مش استخدمهم مش كبير"
  },
  {
   "start": 728.16,
   "end": 729.16,
   "text": "لو في بعض الفورمز"
  },
  {
   "start": 729.16,
   "end": 730.16,
   "text": "اللي عارفين"
  },
  {
   "start": 730.16,
   "end": 731.16,
   "text": "اللي يدخلوا فيها"
  },
  {
   "start": 731.16,
   "end": 732.16,
   "text": "داتة خاصة"
  },
  {
   "start": 732.16,
   "end": 733.16,
   "text": "وداتها مهمة جدا"
  },
  {
   "start": 733.16,
   "end": 734.16,
   "text": "وممكن احتاجوا"
  },
  {
   "start": 734.16,
   "end": 735.16,
   "text": "انهم العايزين"
  },
  {
   "start": 735.16,
   "end": 736.16,
   "text": "يرجعوا فهم"
  },
  {
   "start": 736.16,
   "end": 737.16,
   "text": "احتاجيني"
  },
  {
   "start": 737.16,
   "end": 738.16,
   "text": "كنسلوا"
  },
  {
   "start": 738.16,
   "end": 739.16,
   "text": "وممكن ساعتها"
  },
  {
   "start": 739.16,
   "end": 740.16,
   "text": "نحطلهم زرار كنسل"
  },
  {
   "start": 740.16,
   "end": 741.16,
   "text": "عشان يتأكد انه"
  },
  {
   "start": 741.16,
   "end": 742.16,
   "text": "لما يضغط على كنسل"
  },
  {
   "start": 742.16,
   "end": 743.16,
   "text": "داتة اللي هو كتابها كلها"
  },
  {
   "start": 743.16,
   "end": 744.16,
   "text": "هتروح"
  },
  {
   "start": 744.16,
   "end": 745.16,
   "text": "لكن برضو لدي"
  },
  {
   "start": 745.16,
   "end": 746.16,
   "text": "زرار الكنسل دا"
  },
  {
   "start": 746.16,
   "end": 747.16,
   "text": "هيراركي أقل"
  },
  {
   "start": 747.16,
   "end": 748.16,
   "text": "من الزرار اللي هايخلي"
  },
  {
   "start": 748.16,
   "end": 749.16,
   "text": "سبمت أو كنتيني"
  },
  {
   "start": 749.16,
   "end": 750.16,
   "text": "روح لخطوها اللي بعد كده"
  },
  {
   "start": 751.16,
   "end": 752.16,
   "text": "أخيرا"
  },
  {
   "start": 752.16,
   "end": 753.16,
   "text": "الجايد لائن"
  },
  {
   "start": 753.16,
   "end": 754.16,
   "text": "الأخيرة معنا عن"
  },
  {
   "start": 754.16,
   "end": 755.16,
   "text": "الفورمز"
  },
  {
   "start": 755.16,
   "end": 756.16,
   "text": "أو التكستفيلز"
  },
  {
   "start": 756.16,
   "end": 757.16,
   "text": "نحنا نبعين"
  },
  {
   "start": 757.16,
   "end": 758.16,
   "text": "لليوزر"
  },
  {
   "start": 758.16,
   "end": 759.16,
   "text": "الإرور اللي حصل"
  },
  {
   "start": 759.16,
   "end": 760.16,
   "text": "لو حصل إرور"
  },
  {
   "start": 760.16,
   "end": 761.16,
   "text": "نخلي واضح جدا"
  },
  {
   "start": 761.16,
   "end": 762.16,
   "text": "من تبلو"
  },
  {
   "start": 762.16,
   "end": 763.16,
   "text": "الإرور نفسه"
  },
  {
   "start": 763.16,
   "end": 764.16,
   "text": "الخط الأحمر"
  },
  {
   "start": 764.16,
   "end": 765.16,
   "text": "ممكن يحطلوا آيكوين"
  },
  {
   "start": 765.16,
   "end": 766.16,
   "text": "عشان توضح"
  },
  {
   "start": 766.16,
   "end": 767.16,
   "text": "هنا الإرور"
  },
  {
   "start": 767.16,
   "end": 768.16,
   "text": "ممكن نخلي"
  },
  {
   "start": 768.16,
   "end": 769.16,
   "text": "البوردر برضو"
  },
  {
   "start": 769.16,
   "end": 770.16,
   "text": "لون و أحمر"
  },
  {
   "start": 770.16,
   "end": 771.16,
   "text": "عشان يبين"
  },
  {
   "start": 771.16,
   "end": 772.16,
   "text": "إن الإرور موجود بالشكل دا"
  },
  {
   "start": 772.16,
   "end": 773.16,
   "text": "والمسج نفسها"
  },
  {
   "start": 773.16,
   "end": 774.16,
   "text": "محتاج إن"
  },
  {
   "start": 774.16,
   "end": 775.16,
   "text": "نخلي"
  },
  {
   "start": 775.16,
   "end": 776.16,
   "text": "هوا تحطكم"
  },
  {
   "start": 776.16,
   "end": 777.16,
   "text": "بينه"
  },
  {
   "start": 777.16,
   "end": 778.16,
   "text": "وإيه هو"
  },
  {
   "start": 778.16,
   "end": 779.16,
   "text": "الإرور اللي هو عمله"
  },
  {
   "start": 779.16,
   "end": 780.16,
   "text": "دا هيفكرنا"
  },
  {
   "start": 780.16,
   "end": 781.16,
   "text": "برضو لو"
  },
  {
   "start": 781.16,
   "end": 782.16,
   "text": "رجعنا لي"
  },
  {
   "start": 782.16,
   "end": 783.16,
   "text": "إيوزابلتي"
  },
  {
   "start": 783.16,
   "end": 784.16,
   "text": "هيراستيكس"
  },
  {
   "start": 784.16,
   "end": 785.16,
   "text": "هيفكرنا بالهيراستيك"
  },
  {
   "start": 785.16,
   "end": 786.16,
   "text": "اللي هاد بتكلمنا"
  },
  {
   "start": 786.16,
   "end": 787.16,
   "text": "عن الإيوزر"
  },
  {
   "start": 788.16,
   "end": 789.16,
   "text": "إيه هو الإرور اللي هو عمله"
  },
  {
   "start": 789.16,
   "end": 790.16,
   "text": "وضبط فويقدر إلكفر"
  },
  {
   "start": 790.16,
   "end": 791.16,
   "text": "كمان من"
  },
  {
   "start": 791.16,
   "end": 792.16,
   "text": "الإرور اللي هو"
  },
  {
   "start": 792.16,
   "end": 793.16,
   "text": "يكون نعمل"
  }
 ]
}
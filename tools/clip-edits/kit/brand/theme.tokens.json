{
  "$comment": "Visual tokens for the UX Debugger look. Edit freely; nothing here affects audio, alignment or captions logic.",
  "version": 2,
  "color": {
    "workspace": "#F2F3F6",
    "surface": "#FFFFFF",
    "surfaceAlt": "#F1F2F5",
    "text": "#171A21",
    "textMuted": "#5B6170",
    "textSubtle": "#8A90A0",
    "border": "#DDE1E8",
    "toolbar": "#FFFFFF",
    "select": "#4F46E5",
    "selectSoft": "#EEF0FF",
    "selectText": "#FFFFFF",
    "dim": "rgba(242,243,246,0.72)",
    "note": "#171A21",
    "noteText": "#FFFFFF",
    "change": "#4F46E5",
    "success": "#2B8A3E",
    "warning": "#C2410C",
    "warningSoft": "#FFF1E8",
    "userTouch": "rgba(23,26,33,0.30)",
    "captionBg": "#171A21",
    "captionText": "#FFFFFF",
    "captionActive": "#B9BCFF"
  },
  "demo": {
    "$comment": "Palette of the fictional demo product. Kept distinct from the debugger indigo so selection never looks like product UI.",
    "brand": "#0E7C6B",
    "brandSoft": "#E3F4F0",
    "onBrand": "#FFFFFF"
  },
  "font": {
    "family": "UXGate Sans",
    "fallback": "Cairo, Tahoma, sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "product": "IBM Plex Sans Arabic"
  },
  "type": {
    "$comment": "px on the 1080-wide canvas. Product UI is designed at viewport width (960), so these are on-screen sizes.",
    "productTitle": 44,
    "productRow": 40,
    "productSub": 34,
    "productMeta": 28,
    "note": 40,
    "inspector": 32,
    "toolbar": 28,
    "chip": 26,
    "caption": 50,
    "lineHeight": 1.45
  },
  "radius": {
    "sm": 12,
    "md": 20,
    "lg": 28,
    "viewport": 36,
    "pill": 999
  },
  "stroke": {
    "select": 5,
    "hover": 3,
    "handle": 14
  },
  "shadow": {
    "viewport": "0 24px 60px rgba(23,26,33,0.10), 0 4px 12px rgba(23,26,33,0.06)",
    "note": "0 12px 30px rgba(23,26,33,0.22)",
    "caption": "0 8px 24px rgba(23,26,33,0.18)"
  },
  "layout": {
    "width": 1080,
    "height": 1080,
    "fps": 30,
    "safe": {
      "top": 150,
      "bottom": 465,
      "side": 60,
      "captionSide": 120,
      "$comment": "Bottom 465 px and top 150 px stay free of critical content (platform UI). Captions keep 120 px from the sides (right-edge reaction icons)."
    },
    "viewport": {
      "x": 40,
      "y": 204,
      "w": 1000,
      "h": 690,
      "toolbarH": 64
    },
    "captions": {
      "y": 1262,
      "h": 192
    }
  },
  "motion": {
    "easeOut": [
      0.16,
      1,
      0.3,
      1
    ],
    "easeInOut": [
      0.65,
      0,
      0.35,
      1
    ],
    "enterFrames": 12,
    "cursorTravelFrames": 18,
    "clickFrames": 8,
    "selectFrames": 10,
    "dimFrames": 12,
    "zoomFrames": 20,
    "zoomMax": 1.45,
    "revealStaggerFrames": 3
  },
  "captions": {
    "maxLines": 2,
    "maxCharsPerLine": 30,
    "minPageMs": 900,
    "maxPageMs": 3600,
    "breakOnPauseMs": 280,
    "highlightActiveWord": true
  },
  "colorDark": {
    "$comment": "UXGate night look (design system 2026-10-30). Root sets themeVars(1); the example product resets to the light palette.",
    "workspace": "#00121B",
    "surface": "#032E3B",
    "surfaceAlt": "#08384A",
    "text": "#EAF7FC",
    "textMuted": "#9CC3D3",
    "textSubtle": "#7FA3B5",
    "border": "#1A4F63",
    "toolbar": "#062A36",
    "select": "#4CC3E8",
    "selectSoft": "#08384A",
    "selectText": "#012E4B",
    "dim": "rgba(0,18,27,0.74)",
    "note": "#F2FAFD",
    "noteText": "#012E4B",
    "change": "#78E4FC",
    "success": "#4CD69A",
    "warning": "#FF6B7D",
    "warningSoft": "#3A0F18",
    "userTouch": "rgba(1,46,75,0.38)",
    "captionBg": "#012E4B",
    "captionText": "#FFFFFF",
    "captionActive": "#78E4FC"
  },
  "demoDark": {
    "brand": "#2BB59C",
    "brandSoft": "#16362F",
    "onBrand": "#0D1512"
  }
}
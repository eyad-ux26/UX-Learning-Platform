      "linear": "linear",
      "out": "cubic-bezier(.2,.8,.2,1)",
      "pop": "cubic-bezier(.2,.8,.3,1.25)"
    },
    "rules": [
      "Press: translateY(4px), ledge to 0, 80ms linear",
      "Select: scale .97 to 1, 220ms pop",
      "Reward: scale .6 to 1 with overshoot, 360ms pop; XP counts up over 600ms",
      "Wrong: no shake, no flash",
      "prefers-reduced-motion: no transforms, still frames"
    ]
  }
